package areas{
    abstract class Area {
        # areaId : String

        + Area(areaId : String)
        {abstract} + acceptVisitor(visitor : Visitor) : void
        + getId() : String
    }
    class Partition {

        + Partition(areas : Area[], areaId : String)
        + getAreas() : Area[]
        + acceptVisitor(visitor : Visitor) : void
    }

    Partition --|> Area
    Partition *-- "*" Area : areas

    class Space {

        + Space(doors : Door[], areaId : String)
        + getDoors() : Door[]
        + acceptVisitor(visitor : Visitor) : void
    }

    Space --|> Area
    Space  o-- "*" Door : doors
}

