}

DirectoryAreas --> "1" Area : rootArea
DirectoryAreas --> "*" Door : allDoors
DirectoryAreas --> "1" DirectoryAreas : uniqueInstance

package visitor {
    interface Visitor {
            {abstract} + visitPartition(partition : Partition) : void
            {abstract} + visitSpace(space : Space) : void
        }

        class GetAreaById {
            - areaId : String
            - resultArea : Area
            + GetAreaById(areaId : String)
            + visitPartition(partition : Partition) : void
            + visitSpace(space : Space) : void
            + getResultArea() : Area
        }

        class GetDoorsGivingAccess {
            ~ resultDoors : Door[]
            + visitPartition(partition : Partition) : void
            + visitSpace(space : Space) : void
            + getResultDoors() : Door[]
        }

        class GetSpaces {
            - resultSpaces : Space[]
            + visitPartition(partition : Partition) : void
            + visitSpace(space : Space) : void
            + getResultSpaces() : Space[]
        }

        GetAreaById ..|> Visitor
        GetDoorsGivingAccess ..|> Visitor
        GetSpaces ..|> Visitor
}

@enduml
