package clock_observers {
    interface Observer {
        {abstract} +update(date: LocalDateTime): void
    }

    abstract class Observable {
        {abstract} +addObserver(observer: Observer): void
        {abstract} +removeObserver(observer: Observer): void
        {abstract} +notifyObservers(): void
    }

    Observable o-- "*" Observer : observers

    class Clock {
        -date: LocalDateTime
        -timer: Timer
        -period: int

        +Clock(period: int)
        +addObserver(observer: Observer): void
        +removeObserver(observer: Observer): void
        +notifyObservers(): void
        +start(): void
        +stop(): void
        +getPeriod(): int
        +getDate(): LocalDateTime
    }
    Clock --|> Observable
}
package doorstates{
    abstract class DoorState {
        #door: Door
        #name: String

        +DoorState(door: Door)
        {abstract} +open(): void
        {abstract} +close(): void
        {abstract} +lock(): void
        {abstract} +unlock(): void
        {abstract} +shortly_unlocked(): void
        {abstract} +returnState(): String
    }

    Door "1" *-- "1" DoorState : doorState
    class Locked {
        -startDate: LocalDateTime

        +Locked(door: Door)
        +returnState(): String
        +close(): void
        +lock(): void
        +open(): void
        +unlock(): void
        +shortly_unlocked(): void
        +update(date: LocalDateTime): void
    }

    Locked --|> DoorState
    Locked ..|> Observer

    class Propped {
        +Propped(door: Door)
        +returnState(): String
        +close(): void
        +lock(): void
        +open(): void
        +unlock(): void
        +shortly_unlocked(): void
    }

    Propped --|> DoorState
    class Shortly_Unlocked {
        +Shortly_Unlocked(door: Door)
        +returnState(): String
        +close(): void
        +lock(): void
        +open(): void
        +unlock(): void
        +shortly_unlocked(): void
    }

    Shortly_Unlocked --|> DoorState
    class Unlocked {
        +Unlocked(door: Door)
        +returnState(): String
        +close(): void
        +lock(): void
        +open(): void
        +unlock(): void
        +shortly_unlocked(): void
    }

    Unlocked --|> DoorState
}
package users{
    class UserGroup {
        - validActions : String[]
        - validDays : DayOfWeek[]
        - startHour : LocalTime
        - endHour : LocalTime
        - startDay : LocalDate
        - endDay : LocalDate
        - validDoors : String[]

        + UserGroup(users : ArrayList<User>, validActions : String[], validDays : DayOfWeek[], startHour : LocalTime,
endHour : LocalTime, startDay : LocalDate, endDay : LocalDate, validDoors : String[])
        + canSendRequests(now : LocalDateTime) : boolean
        + canDoAction(action : String) : boolean
        + canBeInSpace(doorId : String) : boolean
        + isUserInGroup(user : User) : boolean
    }

    class User {
    - name : String
