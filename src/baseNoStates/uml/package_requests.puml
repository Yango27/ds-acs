    + User(name: String, credential: String)
    + toString() : String
    }

    UserGroup --> "*" User : users
    DirectoryUsers --> "*" User : "users"
}

package areas{
    abstract class Area {
        # areaId : String

        + Area(areaId : String)
        {abstract} + getSpaces() : Space[]
        {abstract} + getDoorsGivingAccess() : Door[]
        {abstract} + getAreaById(areaId : String) : Area
    }
    class Partition {

        + Partition(areas : Area[], areaId : String)
        + getSpaces() : Space[]
        + getDoorsGivingAccess() : Door[]
        + getAreaById(areaId : String) : Area
    }

    Partition --|> Area
    Partition *-- "*" Area : areas

    class Space {

        + Space(doors : Door[], areaId : String)
        + getSpaces() : Space[]
        + getDoorsGivingAccess() : Door[]
        + getAreaById(areaId : String) : Area
    }

    Space --|> Area
    Space  o-- "*" Door : doors
}

